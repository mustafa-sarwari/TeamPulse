# Server configuration
PORT=4000

# Firebase configuration
# Path to Google service account JSON file (optional if using GOOGLE_APPLICATION_CREDENTIALS)
# GOOGLE_APPLICATION_CREDENTIALS=./server/firebaseServiceAccount.json

# OpenAI configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: choose model (e.g., gpt-3.5-turbo or gpt-4)
OPENAI_MODEL=gpt-3.5-turbo
